#!/usr/bin/env python3
"""Discover mutmut artifacts in a repo and summarize mutation status counts.

Use this for a quick inventory of `*.py.meta` and `mutmut-stats.json` files
and to see which modules currently have the most mutant activity.
"""
from __future__ import annotations

import argparse
import json
import sys
from collections import Counter
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))
from bootstrap_paths import add_project_root

from mutant_common import collect_mutants, find_meta_files, find_stats_files

add_project_root(__file__)
SURVIVING_STATUSES = ("no_tests", "survived")


def build_report(root: Path, top: int) -> dict:
    records = collect_mutants(root)
    status_counts = Counter(record.status for record in records)
    module_counts = Counter(record.module for record in records)
    surviving_module_counts = Counter(
        record.module
        for record in records
        if record.status in SURVIVING_STATUSES
    )

    return {
        "root": str(root),
        "meta_files": [str(path) for path in find_meta_files(root)],
        "stats_files": [str(path) for path in find_stats_files(root)],
        "mutant_count": len(records),
        "status_counts": dict(status_counts.most_common()),
        "top_modules": [
            {"module": module, "count": count}
            for module, count in module_counts.most_common(top)
        ],
        "top_surviving_modules": [
            {"module": module, "count": count}
            for module, count in surviving_module_counts.most_common(top)
        ],
    }


def print_text_report(report: dict, survivors_only: bool = False) -> None:
    print(f"Root: {report['root']}")
    print(f"Meta files: {len(report['meta_files'])}")
    print(f"Stats files: {len(report['stats_files'])}")
    if survivors_only:
        surviving_mutant_count = sum(
            report["status_counts"].get(status, 0) for status in SURVIVING_STATUSES
        )
        print(f"Surviving mutants ({' + '.join(SURVIVING_STATUSES)}): {surviving_mutant_count}")
    else:
        print(f"Mutants discovered: {report['mutant_count']}")
    print("")
    print("Status counts:")
    if survivors_only:
        status_counts = [
            (status, report["status_counts"].get(status, 0))
            for status in SURVIVING_STATUSES
        ]
    else:
        status_counts = report["status_counts"].items()
    for status, count in status_counts:
        print(f"  - {status}: {count}")
    print("")
    top_modules_key = "top_modules"
    top_modules_heading = "Top modules by mutant count:"
    if survivors_only:
        top_modules_key = "top_surviving_modules"
        top_modules_heading = "Top modules by surviving mutant count:"

    print(top_modules_heading)
    for entry in report[top_modules_key]:
        print(f"  - {entry['module']}: {entry['count']}")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Discover mutmut artifacts and summarize mutant status."
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path("."),
        help="Repository root to scan (default: current directory).",
    )
    parser.add_argument(
        "--top",
        type=int,
        default=10,
        help="Number of top modules to show (default: 10).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit JSON instead of a text report.",
    )
    parser.add_argument(
        "--survivors-only",
        action="store_true",
        help="Show surviving-mutant totals only (no_tests + survived) in the text report.",
    )
    args = parser.parse_args()

    root = args.root.resolve()
    report = build_report(root=root, top=args.top)

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_text_report(report, survivors_only=args.survivors_only)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
